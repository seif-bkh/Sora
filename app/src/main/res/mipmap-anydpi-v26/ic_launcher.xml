<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon.

    minSdk is 26, so every supported device understands <adaptive-icon> and no
    legacy density-bucket PNGs (mdpi..xxxhdpi ic_launcher.png) are needed.

    The <monochrome> layer drives Android 13+ themed icons, where the system
    tints the alpha mask to the user's wallpaper palette.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
